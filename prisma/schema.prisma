// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Website contact leads from the inquiry form
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  course    String   // "D.Pharm 1st Year" | "D.Pharm 2nd Year" | "Both (Combo Pack)"
  createdAt DateTime @default(now())
}

// Successful purchases from the payment form
model Purchase {
  id        String   @id @default(cuid())
  name      String
  email     String
  mobile    String
  location  String
  course    String   // "1en" | "1combo" | "2en" | "2combo"
  courseLabel String // human-readable, e.g. "1st Year — Combo (English+Bengali)"
  amount    Int      // in INR
  status    String   @default("PAID") // PAID | PENDING | REFUNDED
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
